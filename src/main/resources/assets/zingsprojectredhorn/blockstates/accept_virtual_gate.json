{
  "multipart": [
    {
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_post"
      }
    },
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_side"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_side_alt"
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": false
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_noside"
      }
    },
    {
      "when": {
        "east": false
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_noside_alt"
      }
    },
    {
      "when": {
        "south": false
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": false
      },
      "apply": {
        "model": "zings_project_red_horn:block/accept_virtual_gate_noside",
        "y": 270
      }
    }
  ]
}